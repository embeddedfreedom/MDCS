#include <math.h>
#include <stdbool.h>
#include "compensator.h"   
#include "flywheel_types.h"
#include "encoder_decoder_logic.h"

// --- CONFIGURABLE VELOCITY TARGET ---
// Change this value to alter the operational steady-state speed of the flywheel disc
#define OMEGA_REF_RAD_S     15.0f  // Target speed in radians per second (rad/s)

// LQR gains computed via augmented-state LQR (matching flywheel_sim.c parameters:
// I_tot=0.0039022, alpha=3.5262, beta=12.3006). Q=diag(250,100), R=0.05.
// State: [theta_dot, int_speed_err]; u = -(k1*theta_dot + k2*int_speed_err)
// Code convention: speed_err = omega - ref, u = K2_SPEED*speed_err + KI_SPEED*int(speed_err)
// Map: K2_SPEED = -k1, KI_SPEED = -k2  (both negative -> restoring)
#define K2_SPEED  -9.7747f  // LQR proportional speed gain (retuned: R=1.0 to reduce rail saturation)
#define KI_SPEED  -7.0711f  // LQR integral speed gain (eliminates steady-state error from b1 friction)

// Persistent state variables for the 1kHz loop execution
static bool initialized = false;
static Decoder dec_flywheel;
static float t_prev = 0.0f;
static float d_filt = 0.0f;       
static float speed_error_sum = 0.0f; 

float run_compensator_cycle(EncoderBus *bus, FlywheelParams *p, int *motor_dir) {
    if (!initialized) {
        decoder_init(&dec_flywheel);
        initialized = true;
    }

    // 1. Process Raw Encoder Data from the 20kHz Simulation Buffer
    for (int i = 0; i < bus->n_pend; i++) {
        decoder_process(&dec_flywheel, bus->pend_states[i]);
    }

    // Z-Pulse Sync tracking (Optional for speed calculation, but preserved for alignment)
    if (bus->z_pend) {
        dec_flywheel.count = (int)(roundf((float)dec_flywheel.count / 4096.0f) * 4096.0f);
        // Wrap snapped value into valid decoder range [-2048, 2047] (±180°).
        while (dec_flywheel.count > 2047) dec_flywheel.count -= 4096;
        while (dec_flywheel.count < -2048) dec_flywheel.count += 4096;
    }

    // 2. State Estimation & Filtering
    const float COUNT_TO_RAD = (2.0f * PI / 4096.0f);
    float t = (float)dec_flywheel.count * COUNT_TO_RAD;
    float d_raw = (t - t_prev) / 0.001f; // 1kHz sampling interval (1ms)
    t_prev = t;

    // Low-Pass Filter (0.8/0.2) to mitigate high-frequency sensor jitter noise
    d_filt = (0.80f * d_filt) + (0.20f * d_raw); 

    // Compute the Velocity Error
    // For pure speed control, position tracking is bypassed (k1 = 0)
    float speed_err = d_filt - OMEGA_REF_RAD_S;

    // Accumulate the speed error over time
    speed_error_sum += speed_err * 0.001f;

    // Anti-windup saturation handling to safeguard against actuator saturation lag
    if (speed_error_sum > 2.0f)  speed_error_sum = 2.0f;
    if (speed_error_sum < -2.0f) speed_error_sum = -2.0f;

    // 3. Control Logic (Velocity Regulation)
    // LQR on velocity: u = K2_SPEED*speed_err + KI_SPEED*speed_error_sum
    float u = (K2_SPEED * speed_err) + (KI_SPEED * speed_error_sum);

    // Direction-dependent deadzone compensation to break stiction thresholds
    if (fabsf(speed_err) > 0.01f) {
        u += (u > 0) ? p->deadzone : -p->deadzone;
    }

    // 4. Output Constraints & Over-voltage Saturation Protection
    if (u > p->Vmax)  u = p->Vmax;
    if (u < -p->Vmax) u = -p->Vmax;

    // Separate magnitude command from structural electrical direction tracking
    *motor_dir = (u >= 0) ? 1 : -1;
    
    // Return normalized PWM duty cycle ratio [0.0 to 1.0]
    return fabsf(u) / p->Vmax;
}
