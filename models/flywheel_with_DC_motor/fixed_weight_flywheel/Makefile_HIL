ROOT = ../../..
BUILD_DIR = $(ROOT)/build/flywheel_control
COMMON = $(ROOT)/framework/common
CODECS = $(ROOT)/framework/transport/codecs

# MCU firmware: shared codebase + the profile's own compensator file
HIL_FIRMWARE_DIR = $(ROOT)/hil/hil_STM32F4
MCU_COMPENSATOR_POS = $(abspath compensator/position_control/compensator_STM32F411.c)
MCU_COMPENSATOR_SPD = $(abspath compensator/speed_control/compensator_STM32F411.c)

CC = gcc
CFLAGS = -Wall -O2 -DHIL_BUILD -I./simulator -I./compensator/hil_control -I$(CODECS) -I$(COMMON) -I$(HIL_FIRMWARE_DIR) \
         -Wno-unused-variable -Wno-unused-result -DHIL_PROFILE

SRCS = simulator/flywheel_sim.c \
       compensator/hil_control/compensator_hil.c \
       $(CODECS)/encoder_decoder_logic.c \
       $(COMMON)/get_keypress.c

BUILD_POS = $(BUILD_DIR)/position
BUILD_SPEED = $(BUILD_DIR)/speed
TARGET_POS = $(BUILD_POS)/flywheel_hil_sim
TARGET_SPEED = $(BUILD_SPEED)/flywheel_hil_sim

.DEFAULT_GOAL := help

.PHONY: all help position speed firmware_position firmware_speed setup_position setup_speed clean

all: position speed

help:
	@echo "Flywheel HIL build"
	@echo "  make -f Makefile_HIL position   # position LQI (host + MCU firmware)"
	@echo "  make -f Makefile_HIL speed      # speed PI (host + MCU firmware)"
	@echo "  make -f Makefile_HIL clean"

position: CFLAGS += -DPOSITION_PROFILE
position: setup_position $(TARGET_POS) firmware_position

speed: CFLAGS += -DSPEED_PROFILE
speed: setup_speed $(TARGET_SPEED) firmware_speed

firmware_position:
	$(MAKE) -C $(HIL_FIRMWARE_DIR) \
		COMPENSATOR=$(MCU_COMPENSATOR_POS) \
		OUTPUT_DIR=$(abspath $(BUILD_POS))

firmware_speed:
	$(MAKE) -C $(HIL_FIRMWARE_DIR) \
		COMPENSATOR=$(MCU_COMPENSATOR_SPD) \
		OUTPUT_DIR=$(abspath $(BUILD_SPEED))

$(TARGET_POS): $(SRCS)
	$(CC) $(CFLAGS) $(SRCS) -o $(TARGET_POS) -lm
	@echo "------------------------------------------------"
	@echo "Position HIL host binary: $(TARGET_POS)"
	@echo "------------------------------------------------"

$(TARGET_SPEED): $(SRCS)
	$(CC) $(CFLAGS) $(SRCS) -o $(TARGET_SPEED) -lm
	@echo "------------------------------------------------"
	@echo "Speed HIL host binary: $(TARGET_SPEED)"
	@echo "------------------------------------------------"

setup_position:
	@mkdir -p $(BUILD_POS)

setup_speed:
	@mkdir -p $(BUILD_SPEED)

clean:
	rm -rf $(BUILD_POS) $(BUILD_SPEED)
