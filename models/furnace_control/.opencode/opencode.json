{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",        // Ask before every file modification
    "bash": {
      "*": "ask",         // Ask before every shell command
      "git *": "allow",   // But auto-approve git (safe)
      "sudo *": "deny",   // Never allow privilege escalation
      "rm *": "deny"      // Never allow rm
    }
  }
}   
