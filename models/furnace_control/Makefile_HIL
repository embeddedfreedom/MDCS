ROOT = ../..
BUILD_DIR = $(ROOT)/build/furnace_control
COMMON = $(ROOT)/framework/common

# MCU firmware: shared codebase + this model's thermal compensator
HIL_FIRMWARE_DIR = $(ROOT)/hil/hil_STM32F4
MCU_COMPENSATOR = $(abspath compensator/compensator_hil_STM32F4.c)

CC = gcc
CFLAGS = -Wall -O2 -I./simulator -I./compensator -I$(COMMON) \
         -Wno-unused-variable -Wno-unused-result

# Host-side sources (SIL simulator + HIL communication layer)
SRCS = simulator/furnace_sim.c \
       compensator/compensator_hil.c \
       $(COMMON)/get_keypress.c

TARGET = $(BUILD_DIR)/furnace_sim_hil

# Build both halves of the HIL system: host loop + MCU firmware
all: host firmware

host: setup $(TARGET)

firmware:
	$(MAKE) -C $(HIL_FIRMWARE_DIR) \
		COMPENSATOR=$(MCU_COMPENSATOR) \
		OUTPUT_DIR=$(abspath $(BUILD_DIR)) \
		EXTRA_CFLAGS=-DHIL_TWO_OUTPUTS

$(TARGET): $(SRCS)
	$(CC) $(CFLAGS) $(SRCS) -o $(TARGET) -lm
	@echo "------------------------------------------------"
	@echo "Build successful!"
	@echo "Host binary located at: $(TARGET)"
	@echo "------------------------------------------------"

setup:
	@mkdir -p $(BUILD_DIR)

clean:
	rm -rf $(BUILD_DIR)

.PHONY: all host firmware setup clean
